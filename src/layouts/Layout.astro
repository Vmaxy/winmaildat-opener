---
import '../styles/global.css';
import { getTranslations, localizedPath, type Locale, type PageKey } from '../i18n';

interface Props {
	title?: string;
	description?: string;
	path?: string;
	locale?: Locale;
	page?: PageKey;
}

const {
	title,
	description,
	path = Astro.url.pathname,
	locale = 'en',
	page = 'home',
} = Astro.props;
const copy = getTranslations(locale);
const canonical = new URL(path, 'https://winmaildatopener.com').toString();
const ogImage = new URL('/og-image.svg', 'https://winmaildatopener.com').toString();
const ogLocale = ({ en: 'en_US', de: 'de_DE', es: 'es_ES', ja: 'ja_JP' } as const)[locale];
const alternateLocales = ({
	en: ['de', 'es', 'ja'],
	de: ['en', 'es', 'ja'],
	es: ['en', 'de', 'ja'],
	ja: ['en', 'de', 'es'],
} satisfies Record<Locale, Locale[]>)[locale];
---
<!doctype html>
<html lang={locale} data-page={page} data-theme="light">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-1QM6CRZJ03"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() { window.dataLayer.push(arguments); }
			gtag('js', new Date());
			gtag('config', 'G-1QM6CRZJ03');
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content=".det opener" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description ?? copy.siteDescription} />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title ?? copy.siteTitle} />
		<meta property="og:description" content={description ?? copy.siteDescription} />
		<meta property="og:site_name" content="Winmail.dat Opener" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Winmail.dat Opener — open winmail.dat files and recover email attachments privately." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title ?? copy.siteTitle} />
		<meta name="twitter:description" content={description ?? copy.siteDescription} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="Winmail.dat Opener — open winmail.dat files and recover email attachments privately." />
		{alternateLocales.map((alternateLocale) => (
			<link rel="alternate" hreflang={alternateLocale} href={new URL(localizedPath(alternateLocale, page), 'https://winmaildatopener.com').toString()} />
		))}
		<link rel="alternate" hreflang={locale} href={canonical} />
		<link rel="alternate" hreflang="x-default" href={new URL(localizedPath('en', page), 'https://winmaildatopener.com').toString()} />
		<meta name="theme-color" id="theme-color" content="#fafafa" />
		<script is:inline>
			(() => {
				const stored = localStorage.getItem('theme');
				const theme = stored === 'dark' || stored === 'light'
					? stored
					: (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.dataset.theme = theme;
				document.documentElement.style.colorScheme = theme;
			})();
		</script>
		<title>{title ?? copy.siteTitle}</title>
	</head>
	<body>
		<slot name="header" />
		<slot />
		<slot name="footer" />
		<script is:inline>
			(() => {
				const toggle = document.querySelector('#theme-toggle');
				const themeColor = document.querySelector('#theme-color');
				const applyTheme = (theme) => {
					const isDark = theme === 'dark';
					document.documentElement.dataset.theme = theme;
					document.documentElement.style.colorScheme = theme;
					localStorage.setItem('theme', theme);
					toggle?.setAttribute('aria-pressed', String(isDark));
					toggle?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
					if (themeColor) themeColor.content = isDark ? '#101418' : '#fafafa';
				};
				const initialTheme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
				applyTheme(initialTheme);
				toggle?.addEventListener('click', () => {
					applyTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark');
				});

			})();
		</script>
	</body>
</html>
