---
import { localizedPath, type Locale, type PageKey } from '../i18n';

interface Props {
	locale: Locale;
	shared: { homeAria: string; privacy: string; about: string; terms: string; contact: string; free: string };
}

const { locale, shared } = Astro.props;
---
<footer class="site-footer">
	<div class="container footer-inner">
		<a class="wordmark" href={localizedPath(locale, 'home')} aria-label={shared.homeAria}>
			<span class="wordmark-mark" aria-hidden="true">↗</span><span>winmail.dat opener</span>
		</a>
		<p><a href={localizedPath(locale, 'about')}>{shared.about}</a> · <a href={localizedPath(locale, 'privacy')}>{shared.privacy}</a> · <a href={localizedPath(locale, 'terms')}>{shared.terms}</a> · <a href={localizedPath(locale, 'contact')}>{shared.contact}</a> · {shared.free}</p>
	</div>
</footer>
