---
import { getTranslations, localizedPath, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getTranslations(locale);
const t = copy.home;
---
<main>
	<section class="hero hero-wide container" aria-labelledby="hero-title">
		<div class="hero-copy">
			<p class="eyebrow">{t.heroEyebrow}</p>
			<h1 id="hero-title">{t.heroTitleBefore} <span>winmail.dat</span>{t.heroTitleAfter}</h1>
			<p class="hero-lede">{t.heroLead}</p>
		</div>
		<div class="hero-orbit" aria-hidden="true">
			<div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
			<div class="file-glyph"><span>.dat</span><svg viewBox="0 0 24 24" fill="none"><path d="M7 3.75h6.5L18 8.25v12H7v-16.5Z" stroke="currentColor" stroke-width="1.5"/><path d="M13 3.75v4.5h5M10 12h5M10 15.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>
		</div>
	</section>

	<section class="tool-section container" id="opener" aria-labelledby="tool-title">
		<div class="tool-card">
			<div class="tool-card-header"><div><p class="eyebrow">{t.toolEyebrow}</p><h2 id="tool-title">{t.toolTitle}</h2></div><span class="privacy-badge"><span class="status-dot"></span>{t.quick}</span></div>
			<div class="dropzone" id="dropzone" tabindex="0" role="button" aria-controls="file-input" aria-describedby="dropzone-help" data-runtime={JSON.stringify(t.runtime)} data-ready={t.ready}>
				<input id="file-input" type="file" accept=".dat,application/octet-stream,application/x-tnef" hidden />
				<div class="upload-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 15V4m0 0L8 8m4-4 4 4M5 14v4.25A1.75 1.75 0 0 0 6.75 20h10.5A1.75 1.75 0 0 0 19 18.25V14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
				<h3>{t.dropTitle}</h3><p id="dropzone-help">{t.browseLead} <button type="button" class="inline-action" id="browse-button">{t.browse}</button></p><span class="file-hint">{t.fileHint}</span>
			</div>
			<div class="tool-status" id="tool-status" aria-live="polite" aria-atomic="true"><span class="status-icon" aria-hidden="true">✓</span><span id="status-text">{t.ready}</span></div>
			<div class="result-panel" id="result-panel" hidden>
				<div class="result-header"><div><p class="eyebrow">{t.recoveredEyebrow}</p><h3 id="result-title">{t.filesReady}</h3></div><button class="button button-dark" id="download-all" type="button">{t.downloadAll} <span aria-hidden="true">↓</span></button></div>
				<div class="partial-notice" id="partial-notice" hidden></div><ul class="attachment-list" id="attachment-list"></ul>
				<div class="result-footer"><span id="result-summary"></span><button class="text-button" id="reset-button" type="button">{t.openAnother}</button></div>
			</div>
			<div class="error-panel" id="error-panel" role="alert" hidden><div class="error-icon" aria-hidden="true">!</div><div><h3 id="error-title">{t.errorTitle}</h3><p id="error-message">{t.errorMessage}</p></div><button class="text-button" id="retry-button" type="button">{t.tryAgain}</button></div>
		</div>
		<p class="privacy-note"><span aria-hidden="true">⊙</span> {t.privacyNote} <a href={localizedPath(locale, 'privacy')}>{t.readPrivacy}</a></p>
	</section>

	<section class="proof-section"><div class="container proof-grid"><div><p class="eyebrow">{t.proofEyebrow}</p><h2>{t.proofTitle}</h2></div><div class="proof-items">{t.proof.map((item, index) => <article><span class="proof-number">0{index + 1}</span><div><h3>{item.title}</h3><p>{item.body}</p></div></article>)}</div></div></section>
	<section class="content-section container" id="how-it-works" aria-labelledby="how-title"><div class="section-heading"><p class="eyebrow">{t.howEyebrow}</p><h2 id="how-title">{t.howTitle}</h2></div><div class="steps-grid">{t.steps.map((step, index) => <article class="step-card"><span>{index + 1}</span><h3>{step.title}</h3><p>{step.body}</p></article>)}</div></section>
	<section class="faq-section" id="faq" aria-labelledby="faq-title"><div class="container faq-layout"><div class="section-heading"><p class="eyebrow">{t.faqEyebrow}</p><h2 id="faq-title">{t.faqTitle}</h2></div><div class="faq-list">{t.faq.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></div></section>
</main>

<script>
	import '../scripts/upload';
</script>
