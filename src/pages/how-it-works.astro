---
import Layout from '../layouts/Layout.astro';
import ContentPage from '../components/ContentPage.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getTranslations } from '../i18n';

const copy = getTranslations('en');
---
<Layout locale="en" page="how-it-works" title="How Winmail.dat Opener works" description={copy.pages.how.lead}>
	<Fragment slot="header"><SiteHeader locale="en" page="how-it-works" navHow={copy.home.navHow} navFaq={copy.home.navFaq} openFile={copy.home.openFile} shared={copy.shared} /></Fragment>
	<ContentPage locale="en" page="how-it-works" />
	<Fragment slot="footer"><SiteFooter locale="en" shared={copy.shared} /></Fragment>
</Layout>
