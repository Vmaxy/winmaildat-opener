---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getTranslations } from '../i18n';

const copy = getTranslations('en');
---
<Layout locale="en" page="home">
	<Fragment slot="header"><SiteHeader locale="en" page="home" navHow={copy.home.navHow} navFaq={copy.home.navFaq} openFile={copy.home.openFile} shared={copy.shared} /></Fragment>
	<HomePage locale="en" />
	<Fragment slot="footer"><SiteFooter locale="en" shared={copy.shared} /></Fragment>
</Layout>
