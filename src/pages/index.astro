---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
---

<Layout>
	<header class="site-header">
		<div class="container nav-inner">
			<a class="wordmark" href="/" aria-label="Winmail.dat Opener home">
				<span class="wordmark-mark" aria-hidden="true">↗</span>
				<span>winmail.dat opener</span>
			</a>
			<nav class="nav-links" aria-label="Main navigation">
				<a href="#how-it-works">How it works</a>
				<a href="#faq">FAQ</a>
				<ThemeToggle />
				<a class="nav-cta" href="#opener">Open a file</a>
			</nav>
		</div>
	</header>

	<main>
		<section class="hero hero-wide container" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow">A private file utility</p>
				<h1 id="hero-title">Find the files hiding inside <span>winmail.dat</span>.</h1>
				<p class="hero-lede">
					Drop in the attachment you could not open. We decode it right in your browser and
					give you the files back — no upload, no account, no waiting.
				</p>
			</div>
			<div class="hero-orbit" aria-hidden="true">
				<div class="orbit orbit-one"></div>
				<div class="orbit orbit-two"></div>
				<div class="file-glyph">
					<span>.dat</span>
					<svg viewBox="0 0 24 24" fill="none"><path d="M7 3.75h6.5L18 8.25v12H7v-16.5Z" stroke="currentColor" stroke-width="1.5"/><path d="M13 3.75v4.5h5M10 12h5M10 15.5h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
				</div>
			</div>
		</section>

		<section class="tool-section container" id="opener" aria-labelledby="tool-title">
			<div class="tool-card">
				<div class="tool-card-header">
					<div>
						<p class="eyebrow">Local decoder</p>
						<h2 id="tool-title">Open your file</h2>
					</div>
					<span class="privacy-badge"><span class="status-dot"></span> Stays on your device</span>
				</div>

				<div class="dropzone" id="dropzone" tabindex="0" role="button" aria-controls="file-input" aria-describedby="dropzone-help">
					<input id="file-input" type="file" accept=".dat,application/octet-stream" hidden />
					<div class="upload-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none"><path d="M12 15V4m0 0L8 8m4-4 4 4M5 14v4.25A1.75 1.75 0 0 0 6.75 20h10.5A1.75 1.75 0 0 0 19 18.25V14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</div>
					<h3>Drop your winmail.dat here</h3>
					<p id="dropzone-help">or <button type="button" class="inline-action" id="browse-button">browse your files</button></p>
					<span class="file-hint">DAT files up to 50 MB</span>
				</div>

				<div class="tool-status" id="tool-status" aria-live="polite" aria-atomic="true">
					<span class="status-icon" aria-hidden="true">✓</span>
					<span id="status-text">Ready when you are.</span>
				</div>

				<div class="result-panel" id="result-panel" hidden>
					<div class="result-header">
						<div>
							<p class="eyebrow">Recovered attachments</p>
							<h3 id="result-title">Your files are ready</h3>
						</div>
						<button class="button button-dark" id="download-all" type="button">Download all <span aria-hidden="true">↓</span></button>
					</div>
					<div class="partial-notice" id="partial-notice" hidden></div>
					<ul class="attachment-list" id="attachment-list"></ul>
					<div class="result-footer">
						<span id="result-summary"></span>
						<button class="text-button" id="reset-button" type="button">Open another file</button>
					</div>
				</div>

				<div class="error-panel" id="error-panel" role="alert" hidden>
					<div class="error-icon" aria-hidden="true">!</div>
					<div>
						<h3 id="error-title">We could not open that file.</h3>
						<p id="error-message">Try a different winmail.dat file, or check the troubleshooting guide.</p>
					</div>
					<button class="text-button" id="retry-button" type="button">Try again</button>
				</div>
			</div>
			<p class="privacy-note"><span aria-hidden="true">⊙</span> Your file is read locally by this page. <a href="/privacy">Read our privacy note.</a></p>
		</section>

		<section class="proof-section">
			<div class="container proof-grid">
				<div>
					<p class="eyebrow">Why use this one</p>
					<h2>Simple when the attachment is not.</h2>
				</div>
				<div class="proof-items">
					<article><span class="proof-number">01</span><div><h3>Private by default</h3><p>File bytes stay in your browser from start to finish.</p></div></article>
					<article><span class="proof-number">02</span><div><h3>Clear recovery</h3><p>See every attachment, its size, and what is ready to download.</p></div></article>
					<article><span class="proof-number">03</span><div><h3>Works anywhere</h3><p>Designed for a quick fix on a laptop, tablet, or phone.</p></div></article>
				</div>
			</div>
		</section>

		<section class="content-section container" id="how-it-works" aria-labelledby="how-title">
			<div class="section-heading">
				<p class="eyebrow">How it works</p>
				<h2 id="how-title">Three small steps to your real attachments.</h2>
			</div>
			<div class="steps-grid">
				<article class="step-card"><span>1</span><h3>Choose the file</h3><p>Find the winmail.dat attachment from your email and drop it above.</p></article>
				<article class="step-card"><span>2</span><h3>We decode locally</h3><p>The TNEF container is unpacked in your browser. Nothing is uploaded.</p></article>
				<article class="step-card"><span>3</span><h3>Download what you need</h3><p>Save attachments one at a time or collect everything in one ZIP.</p></article>
			</div>
		</section>

		<section class="faq-section" id="faq" aria-labelledby="faq-title">
			<div class="container faq-layout">
				<div class="section-heading"><p class="eyebrow">Questions, answered</p><h2 id="faq-title">A little less mystery around that .dat file.</h2></div>
				<div class="faq-list">
					<details><summary>What is a winmail.dat file?</summary><p>Outlook can package rich-text email formatting and attachments in a TNEF container called winmail.dat. Other mail apps may show the container instead of the files inside it.</p></details>
					<details><summary>Does this upload my file?</summary><p>No. The decoder reads the file with browser APIs on your device. The file contents are not sent to our server or a third-party service.</p></details>
					<details><summary>What if I get an error?</summary><p>Make sure you selected the original .dat attachment and that it is smaller than 50 MB. Some files are incomplete or do not contain recoverable attachments.</p></details>
					<details><summary>Can I use this on my phone?</summary><p>Yes. Use the file picker from your mail or files app. The layout and download controls are designed for touch screens.</p></details>
				</div>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="container footer-inner">
			<a class="wordmark" href="/" aria-label="Winmail.dat Opener home"><span class="wordmark-mark" aria-hidden="true">↗</span><span>winmail.dat opener</span></a>
			<p><a href="/privacy">Privacy</a> · <a href="/contact">Contact</a> · Free to use.</p>
		</div>
	</footer>
</Layout>

<script>
	import { zipSync } from 'fflate';
	import { parseTnef } from 'omnimail';

	const MAX_FILE_SIZE = 50 * 1024 * 1024;
	const dropzone = document.querySelector<HTMLDivElement>('#dropzone');
	const input = document.querySelector<HTMLInputElement>('#file-input');
	const browseButton = document.querySelector<HTMLButtonElement>('#browse-button');
	const status = document.querySelector<HTMLDivElement>('#tool-status');
	const statusText = document.querySelector<HTMLSpanElement>('#status-text');
	const resultPanel = document.querySelector<HTMLDivElement>('#result-panel');
	const errorPanel = document.querySelector<HTMLDivElement>('#error-panel');
	const errorTitle = document.querySelector<HTMLHeadingElement>('#error-title');
	const errorMessage = document.querySelector<HTMLParagraphElement>('#error-message');
	const list = document.querySelector<HTMLUListElement>('#attachment-list');
	const resultSummary = document.querySelector<HTMLSpanElement>('#result-summary');
	const partialNotice = document.querySelector<HTMLDivElement>('#partial-notice');
	const downloadAll = document.querySelector<HTMLButtonElement>('#download-all');
	const resetButton = document.querySelector<HTMLButtonElement>('#reset-button');
	const retryButton = document.querySelector<HTMLButtonElement>('#retry-button');
	const statusIcon = document.querySelector<HTMLSpanElement>('.status-icon');
	let attachments: Array<{ name: string; mimeType: string; content: Uint8Array; size: number }> = [];
	let objectUrls: string[] = [];

	const formatBytes = (bytes: number) => {
		if (bytes < 1024) return `${bytes} B`;
		if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
		return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
	};
	const iconFor = (mimeType: string) => mimeType.includes('image') ? '▧' : mimeType.includes('pdf') ? 'PDF' : 'DOC';
	const setStatus = (message: string, state = 'idle') => {
		statusText!.textContent = message;
		status!.dataset.state = state;
		statusIcon!.textContent = state === 'error' ? '!' : state === 'busy' ? '…' : '✓';
	};
	const clearUrls = () => { objectUrls.forEach((url) => URL.revokeObjectURL(url)); objectUrls = []; };
	const showError = (title: string, message: string) => {
		errorTitle!.textContent = title;
		errorMessage!.textContent = message;
		errorPanel!.hidden = false;
		resultPanel!.hidden = true;
		setStatus('There is a problem to fix.', 'error');
	};
	const safeName = (name: string, index: number) => {
		const trimmed = name.trim() || `attachment-${index + 1}`;
		return trimmed.replace(/[\\/:*?"<>|]/g, '-');
	};
	const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({
		'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;',
	}[character] ?? character));
	const renderResults = () => {
		clearUrls();
		list!.innerHTML = '';
		attachments.forEach((attachment) => {
			const contentBuffer = attachment.content.buffer instanceof ArrayBuffer
				? attachment.content.buffer.slice(attachment.content.byteOffset, attachment.content.byteOffset + attachment.content.byteLength)
				: new Uint8Array(attachment.content).buffer;
			const blob = new Blob([contentBuffer], { type: attachment.mimeType || 'application/octet-stream' });
			const url = URL.createObjectURL(blob);
			objectUrls.push(url);
			const item = document.createElement('li');
			item.className = 'attachment-item';
			item.innerHTML = `<span class="attachment-icon" aria-hidden="true">${iconFor(attachment.mimeType)}</span><span class="attachment-meta"><strong>${escapeHtml(attachment.name)}</strong><small>${escapeHtml(attachment.mimeType || 'Unknown type')} · ${formatBytes(attachment.size)}</small></span><a class="download-link" href="${url}" download="${escapeHtml(attachment.name)}" aria-label="Download ${escapeHtml(attachment.name)}">Download <span aria-hidden="true">↓</span></a>`;
			list!.appendChild(item);
		});
		resultSummary!.textContent = `${attachments.length} ${attachments.length === 1 ? 'file' : 'files'} recovered`;
		resultPanel!.hidden = false;
		errorPanel!.hidden = true;
		setStatus('Done. Your files are ready.', 'success');
	};
	const processFile = async (file: File) => {
		resetButton!.disabled = true;
		errorPanel!.hidden = true;
		resultPanel!.hidden = true;
		if (!file.name.toLowerCase().endsWith('.dat')) {
			showError('That does not look like a DAT file.', 'Choose the winmail.dat attachment from your email, then try again.');
			return;
		}
		if (file.size > MAX_FILE_SIZE) {
			showError('That file is larger than 50 MB.', 'For privacy and performance, this browser tool accepts files up to 50 MB.');
			return;
		}
		try {
			setStatus('Reading your file locally…', 'busy');
			await new Promise((resolve) => setTimeout(resolve, 120));
			const bytes = new Uint8Array(await file.arrayBuffer());
			setStatus('Looking for attachments…', 'busy');
			const parsed = parseTnef(bytes);
			attachments = parsed.attachments
				.filter((attachment) => attachment.content?.byteLength)
				.map((attachment, index) => ({
					name: safeName(attachment.filename || '', index),
					mimeType: attachment.mimeType,
					content: attachment.content,
					size: attachment.size || attachment.content.byteLength,
				}));
			const failedAttachments = parsed.attachments.length - attachments.length;
			if (!attachments.length) {
				showError('No attachments were found.', 'This file may only contain email formatting, fonts, or pasted inline images. If you expected a file, download the original attachment again and retry.');
				return;
			}
			partialNotice!.hidden = failedAttachments === 0;
			partialNotice!.textContent = failedAttachments > 0
				? `${failedAttachments} attachment${failedAttachments === 1 ? '' : 's'} could not be recovered. The files below are ready to download.`
				: '';
			renderResults();
		} catch (error) {
			console.error(error);
			showError('We could not decode that file.', 'Try downloading the attachment again. If the problem continues, the file may be incomplete or use an unsupported format.');
		} finally {
			resetButton!.disabled = false;
		}
	};
	const reset = () => {
		clearUrls();
		attachments = [];
		input!.value = '';
		resultPanel!.hidden = true;
		errorPanel!.hidden = true;
		partialNotice!.hidden = true;
		setStatus('Ready when you are.', 'idle');
	};
	const downloadZip = () => {
		if (!attachments.length) return;
		try {
			const files: Record<string, Uint8Array> = {};
			attachments.forEach((attachment, index) => { files[`${String(index + 1).padStart(2, '0')}-${attachment.name}`] = attachment.content; });
			const zip = zipSync(files, { level: 6 });
			const url = URL.createObjectURL(new Blob([zip], { type: 'application/zip' }));
			const link = document.createElement('a');
			link.href = url;
			link.download = 'winmail-attachments.zip';
			link.click();
			setTimeout(() => URL.revokeObjectURL(url), 1000);
		} catch (error) {
			console.error(error);
			showError('The ZIP could not be created.', 'Download the files individually instead, then try again.');
		}
	};
	dropzone?.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('button')) return; input?.click(); });
	dropzone?.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); input?.click(); } });
	browseButton?.addEventListener('click', () => input?.click());
	input?.addEventListener('change', () => { const file = input.files?.[0]; if (file) processFile(file); });
	['dragenter', 'dragover'].forEach((eventName) => dropzone?.addEventListener(eventName, (event) => { event.preventDefault(); dropzone.dataset.dragging = 'true'; }));
	['dragleave', 'drop'].forEach((eventName) => dropzone?.addEventListener(eventName, (event) => { event.preventDefault(); dropzone.dataset.dragging = 'false'; }));
	dropzone?.addEventListener('drop', (event) => { const file = (event as DragEvent).dataTransfer?.files[0]; if (file) processFile(file); });
	downloadAll?.addEventListener('click', downloadZip);
	resetButton?.addEventListener('click', reset);
	retryButton?.addEventListener('click', reset);
</script>
